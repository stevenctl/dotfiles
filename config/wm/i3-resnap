#!/usr/bin/env bash
#
# i3-resnap — make i3 workspace numbering follow physical screen position.
#
# The low range of workspaces goes to the LEFTMOST screen, the high range to
# the next screen to the right (ties broken top-to-bottom). It:
#   1. computes the split from the LIVE output geometry (xrandr),
#   2. writes the `workspace output` assignments to an include file so i3
#      places newly-created workspaces on the correct screen,
#   3. reloads i3, then
#   4. moves already-open workspaces onto their screen.
#
# The workspace SET comes from the i3 config (`set $wsN ...`); the PLACEMENT
# comes from geometry — nothing about left/right is hardcoded. With 10
# workspaces and 2 screens the default split is 1-5 left, 6-10 right.
#
# Usage:  i3-resnap [-n|--dry-run]
#   Override the left-screen count: I3_RESNAP_SPLIT=4 i3-resnap

set -euo pipefail

die() { echo "i3-resnap: $*" >&2; exit 1; }
command -v i3-msg >/dev/null 2>&1 || die "i3-msg not found"
command -v jq >/dev/null 2>&1     || die "jq not found"
i3-msg -t get_version >/dev/null 2>&1 || die "i3 does not appear to be running"

# Workspaces on the FIRST (leftmost) screen. Empty = split evenly across screens.
SPLIT="${I3_RESNAP_SPLIT:-}"

dry=0
case "${1:-}" in
  -n|--dry-run) dry=1 ;;
  "" ) ;;
  -h|--help) sed -n '2,21p' "$0" | sed 's/^#\s\?//'; exit 0 ;;
  *) die "unknown option: $1" ;;
esac

cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/i3"
cfg=""
for c in "$cfg_dir/config" "$HOME/.i3/config" "/etc/xdg/i3/config" "/etc/i3/config"; do
  [ -f "$c" ] && { cfg="$c"; break; }
done
[ -n "$cfg" ] || die "no i3 config found"
gen="$cfg_dir/workspace-outputs.conf"     # generated include file

# --- ordered workspace names from `set $wsN <name>` (in config order) -------
mapfile -t ws_names < <(awk '$1=="set" && $2 ~ /^\$ws[0-9]+$/ {print $3}' "$cfg")
[ "${#ws_names[@]}" -gt 0 ] || die "no \$wsN workspace variables found in $cfg"
n_ws=${#ws_names[@]}

# --- connected+positioned outputs, sorted left->right (x, then y) -----------
mapfile -t outs < <(xrandr --query | awk '
  / connected/ && match($0,/[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/){
    split(substr($0,RSTART,RLENGTH),a,/[x+]/);   # a[3]=x  a[4]=y
    print a[3], a[4], $1
  }' | sort -n -k1,1 -k2,2 | awk '{print $3}')
n_out=${#outs[@]}
[ "$n_out" -gt 0 ] || die "no active outputs"

# --- which output gets the i-th (0-based) workspace -------------------------
out_for_index() {
  local i="$1"
  if [ "$n_out" -eq 1 ]; then echo "${outs[0]}"; return; fi
  if [ -n "$SPLIT" ] && [ "$n_out" -eq 2 ]; then
    [ "$i" -lt "$SPLIT" ] && echo "${outs[0]}" || echo "${outs[1]}"
    return
  fi
  local per=$(( (n_ws + n_out - 1) / n_out ))   # even chunks across screens
  local idx=$(( i / per )); [ "$idx" -ge "$n_out" ] && idx=$(( n_out - 1 ))
  echo "${outs[$idx]}"
}
# fallback list: other outputs, so a workspace still has a home if its screen dies
others() { local pick="$1" o; for o in "${outs[@]}"; do [ "$o" = "$pick" ] || printf ' %s' "$o"; done; }

# --- build assignments ------------------------------------------------------
declare -A target
gen_lines=()
for i in "${!ws_names[@]}"; do
  name="${ws_names[$i]}"; out=$(out_for_index "$i")
  target["$name"]="$out"
  gen_lines+=("workspace \"$name\" output $out$(others "$out")")
done

if [ "$dry" -eq 1 ]; then
  echo "# left->right outputs: ${outs[*]}"
  echo "# would write $gen:"
  printf '  %s\n' "${gen_lines[@]}"
else
  {
    echo "# AUTO-GENERATED by i3-resnap from live output geometry — do not edit."
    echo "# Regenerated on every layout change (mon) or manual 'i3-resnap' run."
    printf '%s\n' "${gen_lines[@]}"
  } > "$gen"
  i3-msg reload >/dev/null    # so NEW workspaces open on the right screen
fi

# --- move already-open workspaces onto their screen -------------------------
ws_json=$(i3-msg -t get_workspaces)
focused=$(echo "$ws_json" | jq -r '.[] | select(.focused).name')

moved=0
while IFS=$'\t' read -r name cur; do
  [ -n "${target[$name]:-}" ] || continue
  dest="${target[$name]}"
  [ "$cur" = "$dest" ] && continue
  if [ "$dry" -eq 1 ]; then
    echo "would move ws '$name': $cur -> $dest"
  else
    i3-msg "workspace --no-auto-back-and-forth \"$name\"; move workspace to output $dest" >/dev/null
    echo "moved ws '$name': $cur -> $dest"
  fi
  moved=$((moved+1))
done < <(echo "$ws_json" | jq -r '.[] | "\(.name)\t\(.output)"')

if [ "$dry" -eq 0 ] && [ -n "$focused" ]; then
  i3-msg "workspace --no-auto-back-and-forth \"$focused\"" >/dev/null
fi

[ "$moved" -eq 0 ] && echo "i3-resnap: existing workspaces already in place." || true
